{
  "name": "Game Notes: Journeyman",
  "short_name": "Journeyman",
  "description": "Dictate thoughts, keep screenshots and clips, and turn your playthrough into a journal.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0e1015",
  "theme_color": "#0e1015",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Quick voice note", "short_name": "Voice note", "url": "./?capture=note", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Add a screenshot or clip", "short_name": "Add screenshot", "url": "./?capture=media", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "media", "accept": ["image/*", "video/*"] }]
    }
  }
}
